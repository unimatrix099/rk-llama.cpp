# Build the RKNPU2 diagnostic/benchmark tools on the target board.
#
#   cd docs/backend && make -f Makefile.rknpu2-tools
#   ulimit -n 65536
#   LD_LIBRARY_PATH=$(LIBS_DIR) ./rknpu2-matmul-layout-bench
#
# Tools (see RKNPU2-int4-research.md for what each one established):
#   rknpu2-matmul-probe         dtype support probe (mixed types rejected on RK3588)
#   rknpu2-matmul-bench         raw throughput, AC_layout=NORM (carries a WARNING - see header)
#   rknpu2-matmul-layout-bench  NORM vs NATIVE sweep (the ~80x INT4 finding)
#   rknpu2-layout-dims-probe    native A/C tiling formats (input for the layout plan)

LIBS_DIR := ../../ggml/src/ggml-rknpu2/libs
CFLAGS   := -O2 -I $(LIBS_DIR)/include
LDLIBS   := $(LIBS_DIR)/librknnrt.so

TOOLS := rknpu2-matmul-probe rknpu2-matmul-bench rknpu2-matmul-layout-bench rknpu2-layout-dims-probe

NL_SRC := ../../ggml/src/ggml-rknpu2/rknpu2-native-layout.c
NL_INC := -I ../../ggml/src/ggml-rknpu2

all: $(TOOLS) test-rknpu2-native-layout test-rknpu2-native-equivalence

%: %.c
	$(CC) $(CFLAGS) $< -o $@ $(LDLIBS)

# Unit tests for the native-layout tiling module (pure CPU, runs anywhere)
test-rknpu2-native-layout: test-rknpu2-native-layout.c $(NL_SRC)
	$(CC) -O0 -g $(NL_INC) $^ -o $@

# Hardware equivalence test (needs the NPU; see file header)
test-rknpu2-native-equivalence: test-rknpu2-native-equivalence.c $(NL_SRC)
	$(CC) $(CFLAGS) $(NL_INC) $^ -o $@ $(LDLIBS)

# Prep-kernel exactness tests (quantization, hadamard, dequant vs scalar
# references incl. rounding ties and extreme-value clamps)
GGML_INC := -I ../../ggml/include -I ../../ggml/src
test-rknpu2-prep-kernels: test-rknpu2-prep-kernels.cpp ../../ggml/src/ggml-rknpu2/rknpu2-quantization.cpp ../../ggml/src/ggml-rknpu2/rknpu2-calibration.cpp
	$(CXX) -O2 $(NL_INC) $(GGML_INC) -fopenmp $^ -o $@

check-prep: test-rknpu2-prep-kernels
	./test-rknpu2-prep-kernels

# Run the CPU unit tests
check: test-rknpu2-native-layout
	./test-rknpu2-native-layout

# Line/branch coverage for the tiling module (gcov)
coverage:
	rm -rf .cov && mkdir .cov
	$(CC) -O0 -g --coverage $(NL_INC) test-rknpu2-native-layout.c $(NL_SRC) -o .cov/tnl
	cd .cov && ./tnl > /dev/null
	 cd .cov && gcov -b tnl-rknpu2-native-layout | grep -E "Lines|Branches|Taken"
	rm -f *.gcov

# Run the on-NPU equivalence test (ulimit -n 65536 first)
check-hw: test-rknpu2-native-equivalence
	LD_LIBRARY_PATH=$(LIBS_DIR) ./test-rknpu2-native-equivalence

clean:
	rm -f $(TOOLS) test-rknpu2-native-layout test-rknpu2-native-equivalence
	rm -rf .cov

.PHONY: all clean check check-prep check-hw coverage
